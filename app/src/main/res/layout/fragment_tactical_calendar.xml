<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendarScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCalendarTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_harmony_capsule_btn"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.14"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="TACTICAL_AUDIT // MATRIX"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvCalendarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/orbitron"
                    android:letterSpacing="0.06"
                    android:text="@string/calendar_title"
                    android:textColor="@color/cyber_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCalendarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/rajdhani"
                    android:text="@string/calendar_subtitle"
                    android:textColor="@color/cyber_text_secondary"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalendarToday"
                style="@style/Widget.Chronos.DaggerButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="HOY"
                android:textColor="@color/neon_cyan"
                app:strokeColor="@color/neon_cyan" />
        </LinearLayout>

        <!-- Monthly Calendar Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalendarGrid"
            style="@style/Widget.Chronos.SandsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cyber_surface_glass"
            app:strokeColor="@color/cyber_rim_highlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mes anterior"
                        android:rotation="-90"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/neon_cyan" />

                    <TextView
                        android:id="@+id/tvCalendarMonthTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/orbitron"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:text="NOVIEMBRE 2026"
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnNextMonth"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Mes siguiente"
                        android:rotation="90"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/neon_cyan" />
                </LinearLayout>

                <!-- Weekday header L M X J V S D -->
                <LinearLayout
                    android:id="@+id/calendarWeekdayRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal" />

                <!-- 6x7 day cells rendered dynamically -->
                <LinearLayout
                    android:id="@+id/calendarGridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weekly Dimension Compliance Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeeklyAudit"
            style="@style/Widget.Chronos.SandsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/cyber_surface_glass"
            app:strokeColor="@color/cyber_border_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWeeklyAuditHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/orbitron"
                        android:letterSpacing="0.08"
                        android:text="AUDITORÍA SEMANAL (4 DIMENSIONES)"
                        android:textColor="@color/cyber_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeeklyComplianceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_harmony_capsule_btn"
                        android:fontFamily="@font/jetbrains_mono"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="0%"
                        android:textColor="@color/neon_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weeklyDimensionAuditContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Selected Day Detailed Audit Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDayDetailAudit"
            style="@style/Widget.Chronos.SandsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/cyber_surface_glass"
            app:strokeColor="@color/cyber_rim_highlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSelectedDayTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/orbitron"
                            android:text="AUDITORÍA DEL DÍA"
                            android:textColor="@color/cyber_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectedDaySummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="0m enfoque · 0% cumplimiento"
                            android:textColor="@color/cyber_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSelectedDayScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_harmony_capsule_btn"
                        android:fontFamily="@font/jetbrains_mono"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="0%"
                        android:textColor="@color/neon_magenta"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayHabitAuditListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
