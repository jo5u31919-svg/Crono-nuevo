<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Prince of Persia PS5 Specular Rim: Golden Sands -> Mystic Temporal Blue -> Critical Crimson -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#772997FF"
                android:endColor="#AAFF1E56"
                android:startColor="#DDE6B84D" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Deep Smoked Obsidian Glass Core -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="160"
                android:centerColor="#E818120C"
                android:endColor="#EE110C08"
                android:startColor="#E4241A10" />
            <corners android:radius="24.5dp" />
        </shape>
    </item>
</layer-list>
